# Diamond Events backend — required environment
#
# Copy to `.env` (gitignored) for local development, or set these as real
# environment variables in staging and production.
#
# Values without a default are REQUIRED: the application will refuse to start
# without them rather than fall back to a shared or stale value.
#
# ---------------------------------------------------------------------------
# ROTATE BEFORE FIRST DEPLOY
# ---------------------------------------------------------------------------
# The database password, SSL keystore password, Google OAuth client secret, JWT
# signing secret and Gmail app password were all committed to this repository in
# plaintext and remain readable in its git history. Every one of them must be
# rotated. Removing them from the working tree, as this branch does, does not
# invalidate the old values.
# ---------------------------------------------------------------------------

# --- Server ---
SERVER_PORT=8081

# --- Database (required) ---
DB_URL=jdbc:postgresql://localhost:5432/live_diamond_ev
DB_USERNAME=postgres
DB_PASSWORD=

# --- TLS ---
# Set SSL_ENABLED=false for local development over plain HTTP.
SSL_ENABLED=true
SSL_KEYSTORE_PATH=/root/diamondevent_be/plesk_crt.pfx
SSL_KEYSTORE_PASSWORD=

# --- Uploads ---
UPLOAD_DIR=/root/diamondevent_be/uploads/

# --- Frontends ---
FRONTEND_BASE_URL=https://diamondevents.uk
FRONTEND_ADMIN_URL=https://diamondevents.uk/admin

# Comma-separated. Production should list only real origins — no localhost.
CORS_ALLOWED_ORIGINS=https://diamondevents.uk

# --- Google SSO (required) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple SSO ---
APPLE_CLIENT_ID=co.uk.zarbotics.web.sso
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=/opt/keys/apple/AuthKey.p8

# --- JWT (required) ---
# Minimum 32 bytes for HS256. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_VERIFICATION_EXPIRATION_MS=604800000

# --- Mail (required) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
