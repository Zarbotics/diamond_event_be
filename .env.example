# Diamond Events backend — environment
#
# ---------------------------------------------------------------------------
# YOU DO NOT NEED ANY OF THIS TO RUN LOCALLY.
#
# A clean checkout starts with nothing but a local PostgreSQL:
#
#     createdb diamond_ev
#     ./mvnw spring-boot:run
#
# application.properties carries development defaults for everything below.
# This file is for STAGING AND PRODUCTION, which run with:
#
#     SPRING_PROFILES_ACTIVE=prod          # Google sign-in only
#     SPRING_PROFILES_ACTIVE=prod,apple    # Google + Apple
#
# Under `prod`, ProductionConfigCheck refuses to start if any development
# default survived — a silent fallback to a shared signing secret is worse
# than a deploy that does not start.
# ---------------------------------------------------------------------------
#
# ROTATE THESE BEFORE THE NEXT DEPLOY
# The database password, SSL keystore password, Google OAuth client secret,
# JWT signing secret and Gmail app password were all committed to this
# repository in plaintext and remain readable in its git history. Removing
# them from the working tree does not invalidate them.
# ---------------------------------------------------------------------------

# --- Required in prod ---
DB_URL=jdbc:postgresql://localhost:5432/live_diamond_ev
DB_USERNAME=postgres
DB_PASSWORD=

# Minimum 32 bytes for HS256.  Generate with:  openssl rand -base64 48
JWT_SECRET=

# Comma-separated. Production must not include localhost.
CORS_ALLOWED_ORIGINS=https://diamondevents.uk

FRONTEND_BASE_URL=https://diamondevents.uk
FRONTEND_ADMIN_URL=https://diamondevents.uk/admin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

UPLOAD_DIR=/root/diamondevent_be/uploads/

# --- TLS ---
# Set SSL_ENABLED=false if a reverse proxy terminates TLS.
SSL_ENABLED=true
SSL_KEYSTORE_PATH=/root/diamondevent_be/plesk_crt.pfx
SSL_KEYSTORE_PASSWORD=

# --- Apple sign-in — production only ---
# There is one Apple developer account and one signing key, so Apple exists in
# production and the development branches run Google alone. Add `apple` to
# SPRING_PROFILES_ACTIVE and set all four:
APPLE_CLIENT_ID=co.uk.zarbotics.web.sso
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=/opt/keys/apple/AuthKey.p8

# --- Optional ---
SERVER_PORT=8081
# Flyway owns the schema. `validate` means Hibernate checks it matches and
# changes nothing — `update` lets Hibernate alter tables behind Flyway's back,
# and the migration that notices the disagreement is the one that fails.
DDL_AUTO=validate
FLYWAY_ENABLED=true
SHOW_SQL=false

# ---------------------------------------------------------------------------
# THE DOCKER DEMO
#
# The demo runs the application and a Postgres container side by side, so the
# database comes from the container's own variables rather than DB_URL. The
# prod profile composes the URL from them:
#
#     jdbc:postgresql://diamond-postgres:5432/${POSTGRES_DB}
#
# Set DB_URL as well only if the database is not that sibling container.
# ---------------------------------------------------------------------------
POSTGRES_DB=diamond_event
POSTGRES_USER=diamond
POSTGRES_PASSWORD=

# Both front ends are on one host, so one origin covers them. No trailing
# slash — a trailing slash does not match and the browser blocks every call.
CORS_ALLOWED_ORIGINS=https://happy-moser.77-68-54-2.plesk.page
FRONTEND_BASE_URL=https://happy-moser.77-68-54-2.plesk.page
FRONTEND_ADMIN_URL=https://happy-moser.77-68-54-2.plesk.page/admin

# Traefik terminates TLS in front of the container, so the application holds no
# certificate and needs no keystore.
SSL_ENABLED=false

# A mounted volume. Uploaded documents and generated reports have to survive a
# redeploy, and the image does not.
UPLOAD_DIR=/app/uploads/

# Where the browser fetches an uploaded picture from. Absolute, and pointing at
# the API host: the value is stored against the picture and handed to the front
# end, which is on a different origin, so a relative URL resolves against the
# front end's host where the file does not exist. It must also carry the
# context path — the code's default is /diamond/deimg, written when that was
# the context path, and this profile serves on /api/diamond.
UPLOAD_PUBLIC_BASE_URL=https://api-de-demo.happy-moser.77-68-54-2.plesk.page/api/diamond/deimg
